[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = visual-studio-code-bin

[Action]
Description = Patch VSCode launch script to use xdg-desktop-portals
Depends = sed
When = PostTransaction
Exec = /usr/bin/sed -i 's|^exec /opt/visual-studio-code/bin/code *|GTK_USE_PORTAL=1 &|' /usr/bin/code
