[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = davinci-resolve
Target = davinci-resolve-studio
Target = davinci-resolve-beta
Target = davinci-resolve-studio-beta

[Action]
Description = Patch DaVinci Resolve desktop shortcuts to use xcb
Depends = sed
When = PostTransaction
Exec = /usr/bin/sed -i -e 's|^Exec=|&env QT_QPA_PLATFORM=xcb |' /usr/share/applications/DaVinciResolve.desktop && /usr/bin/sed -i -e 's|^Exec=|&env QT_QPA_PLATFORM=xcb |' /usr/share/applications/DaVinciControlPanelsSetup.desktop
