(defsrc             ;; Keys to be modified
  lsft rsft caps
)

(defalias           ;; Modification actions
  ldblcaps (tap-dance-eager 200 (lsft caps))
  rdblcaps (tap-dance-eager 200 (rsft caps))
  escctrl (tap-hold-press 200 200 esc lctrl)
)

(deflayer base      ;; Bind action to keys
  @ldblcaps @rdblcaps @escctrl
)
