body-font-family='Fira Code'
body-font-size=14

[gnome/shell/extensions/pano/emoji-item]
emoji-size=64

[gnome/shell/extensions/space-bar/shortcuts]
open-menu=@as []

[gnome/shell/extensions/vitals]
alphabetize=true
fixed-widths=true
hide-icons=false
hide-zeros=true
hot-sensors=['__temperature_avg__', '__network-rx_max__']
icon-style=1
include-static-info=false
menu-centered=true
show-fan=false
show-memory=true
show-processor=true
show-storage=false
show-system=false
show-temperature=true
show-voltage=false
update-time=1
use-higher-precision=false


[gnome/shell/keybindings]
focus-active-notification=@as []
toggle-message-tray=['<Super>n']

[gnome/shell/world-clocks]
locations=@av []

[gnome/tweaks]
show-extensions-notice=false

[gtk/gtk4/settings/file-chooser]
date-format='regular'
location-mode='path-bar'
show-hidden=false
show-size-column=false
show-type-column=false
sidebar-width=170
sort-column='name'
sort-directories-first=true
sort-order='ascending'
startup-mode='cwd'
type-format='category'
view-type='list'
window-size=(980, 780)

[gtk/settings/file-chooser]
clock-format='12h'
location-mode='filename-entry'
show-size-column=false
show-type-column=false
startup-mode='cwd'
