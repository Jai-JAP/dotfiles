{{- $gpu := includeTemplate "config/gpu.tmpl" . -}}
{{- $installType := includeTemplate "config/installType.tmpl" . -}}
{{- $osType := includeTemplate "config/osType.tmpl" . -}}

data:
  logLevel: 1
  user:
    name: {{ promptStringOnce . "name" "Name" }}
    email: {{ promptStringOnce . "email" "Email Address" }}
  deviceConfig:
    gpu: {{ $gpu }}
    installType: {{ $installType }}
    osType: {{ $osType }}
  customization:
    sudo:
      pwfeedback: false

diff:
  pager: delta
edit:
  command: micro
merge:
  command: "bash"
  args:
  - "-c"
  - cp {{ "{{" }} .Target | quote {{ "}}" }} {{ "{{" }} printf "%s.base" .Target | quote {{ "}}" }} && code -nwm {{ "{{" }} .Destination | quote {{ "}}" }} {{ "{{" }} .Target | quote {{ "}}" }} {{ "{{" }} printf "%s.base" .Target | quote {{ "}}" }} {{ "{{" }} .Source | quote {{ "}}" }}"
