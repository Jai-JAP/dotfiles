#!/bin/bash
# chezmoi:template:left-delimiter="#{{" right-delimiter=}}

#{{ $rootSourceDir := joinPath .chezmoi.workingTree "root" -}}
# root config checksum: #{{ output "sh" "-c" (printf "find %s -type f -print0 | sort -z | xargs -r0 sha256sum | sha256sum" $rootSourceDir) }}

#{{ includeTemplate "utils/logger.sh.tmpl" . }}

original_args=(
  #{{ rest .chezmoi.args | quoteList | join " " }}
)
args=(apply)

# Skip if NO_ROOTMOI is set
if [[ -n "${NO_ROOTMOI:-}" ]]; then
  exit 0
fi

# Filter out incompatible args
skip_one_more=false
for i in "${!original_args[@]}"; do
  if [[ "${skip_one_more}" == true ]]; then
    skip_one_more=false
    continue
  fi

  if [[ "${original_args[i]}" == "-S" ||
    "${original_args[i]}" == "--source" ]]; then
    skip_one_more=true
    continue
  fi

  if [[ "${original_args[i]}" == "-S="* ||
    "${original_args[i]}" == "--source="* ]]; then
    continue
  fi

  # We will always apply, so we don't need any --apply flags
  if [[ "${original_args[i]}" == "-a" ||
    "${original_args[i]}" == "-a="* ||
    "${original_args[i]}" == "--apply" ||
    "${original_args[i]}" == "--apply="* ]]; then
    continue
  fi

  # --init never makes sense, because rootmoi's configuration is handled by chezmoi earlier
  if [[ "${original_args[i]}" == "--init" ]]; then
    continue
  fi

  # --one-shot is not compatible with apply
  if [[ "${original_args[i]}" == "--one-shot" ]]; then
    continue
  fi

  # Remove any positional args, as we will always use apply
  if [[ "${original_args[i]}" != "-"* ]]; then
    continue
  fi

  args+=("${original_args[i]}")
done

#{{- $configDir := joinPath .chezmoi.homeDir ".config/rootmoi" -}}
#{{- $configFile := joinPath $configDir "rootmoi.yaml" -}}
#{{- $persistentStateFile := joinPath $configDir "rootmoistate.boltdb" -}}
#{{- $cacheDir := joinPath .chezmoi.homeDir ".cache/rootmoi" }}

log_info "Applying root dotfiles"
log_debug "rootmoi" "${args[@]}"

# shellcheck disable=SC2232
sudo --preserve-env chezmoi "${args[@]}" \
  --config='#{{ $configFile }}' \
  --persistent-state='#{{ $persistentStateFile }}' \
  --cache='#{{ $cacheDir }}'
