#!/bin/bash
# chezmoi:template:left-delimiter="#{{" right-delimiter=}}

#{{ includeTemplate "utils/github_release.sh.tmpl" . }}

set -euo pipefail

GCM_DIR="/usr/local/share/gcm"
GCM_EXE="$GCM_DIR/git-credential-manager.exe"
ARCH='#{{ .chezmoi.arch | replace "amd64" "x64" }}'

get_installed_version() {
  if [ -x "$GCM_EXE" ]; then
    "$GCM_EXE" --version 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+){2}' || true
  fi
}

install_or_update() {
  local latest_ver="$1"
  local url zip tmpdir

  url="https://github.com/git-ecosystem/git-credential-manager/releases/download/v${latest_ver}/gcm-win-${ARCH}-${latest_ver}.zip"
  tmpdir="$(mktemp -d)"
  zip="$tmpdir/gcm.zip"
  trap 'rm -rf "$tmpdir"' EXIT

  log_info "Downloading Git Credential Manager v${latest_ver}..."
  wget -qc --show-progress --progress=bar:force:noscroll -O "$zip" "$url"

  log_info "Installing to $GCM_DIR..."
  sudo install -d "$GCM_DIR"
  sudo unzip -o "$zip" -d "$GCM_DIR" >/dev/null
  sudo chmod a+x "$GCM_EXE"

  if ! [[ :"$(cmd.exe /c 'echo %WSLENV%' 2>/dev/null)": = *:GIT_EXEC_PATH/wp:* ]]; then
    /mnt/c/Windows/System32/setx.exe WSLENV "$WSLENV:GIT_EXEC_PATH/wp" >/dev/null || true
  fi

  log_success "Git Credential Manager v${latest_ver} installed successfully!"
}

install_external "Git Credential Manager" "git-ecosystem/git-credential-manager"
