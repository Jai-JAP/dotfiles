#!#{{ lookPath "bash" }}
# chezmoi:template:left-delimiter="#{{" right-delimiter=}}

#{{ $packageList := .deviceConfig.osType -}}
#{{- if eq .deviceConfig.installType "termux" -}}
#{{-   $packageList = "termux" -}}
#{{- end -}}
#{{- $packages := include (printf "packages/%s.yaml" $packageList) | fromYaml -}}
# packages checksum: #{{ $packages | toString | sha1sum }}

#{{ includeTemplate "utils/logger.sh.tmpl" . }}
#{{ includeTemplate "utils/filter_installed.sh" . }}

{
#{{- if eq .deviceConfig.osType "arch" -}}
#{{-   if not (lookPath "paru") }}

  log_info "paru not found, installing it now..."

  sudo pacman -Sy --noconfirm base-devel git

  tmpdir=$(mktemp -d)
  git clone --depth 1 "https://aur.archlinux.org/paru-bin.git" "$tmpdir/paru-bin"
  pushd "$tmpdir/paru-bin" &>/dev/null || { log_error "Failed to change directory to paru-bin build directory"; exit 1; }
  makepkg -sic --noconfirm
  popd || { log_error "Failed to change directory back to current working directory"; exit 1; }
  rm -rf "$tmpdir"

  log_success "paru installed successfully."

#{{-   else }}

  log_info "paru is already installed."

#{{-  end -}}
#{{- end -}}

#{{- $allPackages := list -}}
#{{- $allPackages = concat $allPackages $packages.common -}}
#{{- if and (eq .deviceConfig.installType "desktop") (hasKey $packages.desktop) -}}
#{{-   $allPackages = concat $allPackages $packages.desktop -}}

#{{-   if and (eq .deviceConfig.gpu "intel") (hasKey $packages "intel") -}}
#{{-     $allPackages = concat $allPackages $packages.intel -}}
#{{-   end -}}
#{{-   if and (eq .deviceConfig.gpu "amd") (hasKey $packages "amd") -}}
#{{-     $allPackages = concat $allPackages $packages.amd -}}
#{{-   end -}}
#{{-   if and (eq .deviceConfig.gpu "nvidia") (hasKey $packages "nvidia") -}}
#{{-     $allPackages = concat $allPackages $packages.nvidia -}}
#{{-   end -}}

#{{-   if and (eq (env "XDG_SESSION_DESKTOP") "GNOME") (hasKey $packages "gnome") -}}
#{{-     $allPackages = concat $allPackages $packages.gnome -}}
#{{-   end -}}
#{{-   if and (eq (env "XDG_SESSION_DESKTOP") "KDE") (hasKey $packages "kde") -}}
#{{-     $allPackages = concat $allPackages $packages.kde -}}
#{{-   end -}}
#{{- else if and (eq .deviceConfig.installType "server") (hasKey $packages "server") -}}
#{{-   $allPackages = concat $allPackages $packages.server -}}
#{{- else if and (eq .deviceConfig.installType "wsl") (hasKey $packages "wsl") -}}
#{{-   $allPackages = concat $allPackages $packages.wsl -}}
#{{- end }}

  packages_to_install=(
    #{{ join " " $allPackages }}
  )

  # shellcheck disable=SC1143
  mapfile -t packages_filtered < <(filter_installed \
    #{{ if eq .deviceConfig.osType "arch" }}paru -Qq -- \
    #{{ else if or (eq .deviceConfig.osType "ubuntu") (eq .deviceConfig.installType "termux") }}dpkg-query -W -f='${package}\n' -- \
    #{{ end -}}
    "${packages_to_install[@]}"
  )

  if (( ${#packages_filtered[@]} )); then
    # shellcheck disable=SC2154
    log_info "Installing #{{ $packageList | title }} Packages"
#{{ if eq .deviceConfig.osType "arch" }}
    paru -Syu --noconfirm --needed "${packages_filtered[@]}"
#{{- else if eq .deviceConfig.osType "ubuntu" }}
    sudo apt-get update
    sudo apt-get install -y --no-install-recommends "${packages_filtered[@]}"
#{{- else if eq .deviceConfig.installType "termux" }}
    pkg update -y
    pkg upgrade -y "${packages_filtered[@]}"
#{{- end }}
  else
    log_info "All packages are already installed."
  fi

}
