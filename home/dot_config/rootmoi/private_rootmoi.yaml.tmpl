{{- $chezmoiData := deepCopy . -}}
{{- $chezmoiData = unset $chezmoiData "chezmoi" -}}

{{- $sourceDir := joinPath .chezmoi.workingTree "root" -}}
sourceDir: "{{ $sourceDir }}"

destDir: "{{ joinPath (env "PREFIX") "/" }}"

diff:
  pager: delta
  exclude:
    - scripts
edit:
  command: micro
merge:
  command: "bash"
  args:
  - "-c"
  - cp {{ "{{" }} .Target | quote {{ "}}" }} {{ "{{" }} printf "%s.base" .Target | quote {{ "}}" }} && code -nwm {{ "{{" }} .Destination | quote {{ "}}" }} {{ "{{" }} .Target | quote {{ "}}" }} {{ "{{" }} printf "%s.base" .Target | quote {{ "}}" }} {{ "{{" }} .Source | quote {{ "}}" }}"
status:
  exclude:
    - always

data:
  nonRootUser: "{{ .chezmoi.username }}"
  {{- $chezmoiData | toYaml | trim | nindent 2 }}
