#!/bin/bash

if [[ "$TERM_PROGRAM" != "vscode" && "$TERM" != "linux" ]]; then
  if [[ ! "$PREFIX" =~ com.termux ]]; then
    ble-import contrib/prompt-git
    #shellcheck disable=SC2016
    bleopt prompt_rps1='${_ble_contrib_prompt_git_base:+\q{contrib/git-branch} (\q{contrib/git-hash})}' \
      prompt_rps1_transient=1
    # RPS1='${_ble_contrib_prompt_git_base:+ \g{bold}| \g{reset}\q{contrib/git-branch} (\q{contrib/git-hash})}'

    if paru -Qq fzf &>/dev/null; then
      ble-import integration/fzf-completion
      ble-import integration/fzf-key-bindings

      _fzf_setup_completion path micro

      _ble_contrib_fzf_git_config=key-binding
      ble-import -d integration/fzf-git
    fi
  fi

  ble-bind -m emacs -f 'C-h' delete-backward-cword
  ble-bind -m emacs -f 'C-w' ''
elif [[ "$TERM" != "linux" ]]; then
  ble-bind -m emacs -f 'C-w' delete-backward-cword
  ble-bind -m emacs -f 'C-h' ''
else
  ble-bind -m emacs -f 'C-h' ''
  ble-bind -m emacs -f 'C-w' ''
  ble-bind -m emacs -f 'C-M-?' delete-backward-cword

  bleopt complete_auto_complete=
fi

# bleopt prompt_rps1="\$(RET=\$?; if [[ \$RET != 0 ]]; then echo \"\\g{bold,fg=red}\$RET\\g{reset}\"; fi)$RPS1" \
#   prompt_rps1_transient=1

ble-bind -m emacs -f M-up 'history-search-backward immediate-accept:hide-status:action=load:empty=history-move'
ble-bind -m emacs -f M-down 'history-search-forward immediate-accept:hide-status:action=load:empty=history-move'

ble-bind -m emacs -f C-up 'history-prev'
ble-bind -m emacs -f C-down 'history-next'

bleopt edit_vbell= \
  decode_error_char_vbell= \
  decode_error_cseq_vbell= \
  decode_error_kseq_vbell= \
  prompt_ruler=empty-line \
  tab_width=2 \
  edit_magic_accept=autocd \
  indent_offset=2 \
  indent_tabs=0

ble-face auto_complete='fg=240' \
  command_builtin='fg=86' \
  command_builtin_dot='fg=86' \
  command_function='fg=108,bold' \
  syntax_quotation='fg=124,bold' \
  syntax_quoted='fg=136,bold' \
  syntax_delimiter='fg=88,bold' \
  syntax_function_name='fg=108,bold' \
  region_match='fg=white,bg=124'

if [[ "$EUID" == 0 ]]; then
  FG_COLOR=160
else
  FG_COLOR=70
fi

if [[ "$TERM" != "linux" ]]; then
  _arrow="󰜴"
  _arrow_thin="➞ "
  _dir="󰉋"
else 
  _arrow="=>"
  _arrow_thin="->"
  _dir="\e[33;1mDIR changed\e[0m"
fi

bleopt prompt_ps1_final="\e]133;A\a\e[0m\g{bold,fg=${FG_COLOR}}${_arrow} \g{reset}\e]133;B\a\e[0m"
blehook PREEXEC+="echo -ne '\e]133;C\a\e[0m'; " \
  POSTEXEC+="echo -ne '\e]133;D;'\${?}'\a\e[0m'; " \
  CHPWD="echo -ne '${_dir} ${_arrow_thin}\e[33;1m'; pwd | sed 's|'${HOME}'|~|'; echo -ne '\e[0m'; "

if [[ "$TERM_PROGRAM" == "vscode" ]]; then
  blehook PREEXEC+="echo -ne '\e]633;E'\${1}'\a\e[0m'; " \
    CHPWD+="echo -ne '\e]633;P;Cwd='\$(pwd)'\a\e[0m'; "
fi


#shellcheck disable=SC2016
ble/function#advice around ble/widget/default/accept-line '
  ble-edit/content/clear-arg
  [[ ${_ble_edit_str//["${_ble_term_IFS}"]} ]] && ble/function#advice/do'

#shellcheck disable=SC2016
ble/function#advice around ble/widget/discard-line '
  ble-edit/content/clear-arg
  [[ ${_ble_edit_str//["${_ble_term_IFS}"]} ]] && ble/function#advice/do'
