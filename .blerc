if [[ "$TERM_PROGRAM" != "vscode" ]]; then
  if [[ ! "$PREFIX" =~ "com.termux" ]]; then
    ble-import contrib/prompt-git
    bleopt prompt_rps1='${_ble_contrib_prompt_git_base:+\q{contrib/git-branch} (\q{contrib/git-hash})}' \
      prompt_rps1_transient=1
    # RPS1='${_ble_contrib_prompt_git_base:+ \g{bold}| \g{reset}\q{contrib/git-branch} (\q{contrib/git-hash})}'
  fi

  ble-bind -f 'C-h' delete-backward-cword
  ble-bind -m emacs -f 'C-w' ''
else
  ble-bind -f 'C-h' ''
  ble-bind -m emacs -f 'C-w' delete-backward-cword
fi

# bleopt prompt_rps1="\$(RET=\$?; if [[ \$RET == 0 ]]; then echo \"\\g{bold,fg=green}\$RET\\g{reset}\"; else echo \"\\g{bold,fg=red}\$RET\\g{reset}\"; fi)$RPS1" \
#   prompt_rps1_transient=1

bleopt edit_vbell= \
  decode_error_char_vbell= \
  decode_error_cseq_vbell= \
  decode_error_kseq_vbell= \
  prompt_ruler=empty-line \
  tab_width=2 \
  edit_magic_accept=autocd \
  edit_magic_expand=autocd

ble-face auto_complete='fg=240' \
  command_builtin='fg=86' \
  command_builtin_dot='fg=86' \
  command_function='fg=108,bold' \
  syntax_quotation='fg=124,bold' \
  syntax_quoted='fg=136,bold' \
  syntax_delimiter='fg=88,bold' \
  syntax_function_name='fg=108,bold'

if [[ "$EUID" == 0 ]]; then
  FG_COLOR=160
else
  FG_COLOR=70
fi
bleopt prompt_ps1_final="\g{bold,fg=$FG_COLOR}󰜴 \g{reset} "

bleopt indent_offset=2 indent_tabs=0
blehook CHPWD="echo -ne '\Uf024b ➞ \033[33;1m'; pwd | sed 's|'$HOME'|~|'; echo -ne '\033[0m'"

ble/function#advice around ble/widget/default/accept-line '
  ble-edit/content/clear-arg
  [[ ${_ble_edit_str//["$_ble_term_IFS"]} ]] && ble/function#advice/do'

ble/function#advice around ble/widget/discard-line '
  ble-edit/content/clear-arg
  [[ ${_ble_edit_str//["$_ble_term_IFS"]} ]] && ble/function#advice/do'
