# customisations
HISTCONTROL=ignoreboth
ANDROID_HOME=/opt/AndroidSDK
FLUTTER_HOME=/opt/flutter
PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin/:$ANDROID_HOME/platform-tools:/opt/flutter


if [[ $- == *i* ]]; then
  gcc() {
	if [[ "$1" == *".c" ]]; then
	    if ! [[ "$*" =~ "-o" ]]; then
		command gcc $@ -o ${1%.c}
	    else
		command gcc $@
	    fi
	elif [[ "$1" == *".cpp" ]]; then
	    if ! [[ "$*" =~ "-o" ]]; then
		command g++ $@ -o ${1%.cpp}
	    else
		command g++ $@
	    fi
	fi
  }    
  
  if [[ $EUID == 0 ]]; then
    PS1='${SUDO_USER:+(\033[01;33m$SUDO_USER\033[0m) }\[\033[01;31m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\] \n \[\033[01;31m\]\$_\[\033[00m\] '
  else
    PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\] \n \[\033[01;32m\]\$_\[\033[00m\] '
  fi
  if [[ "$TERM_PROGRAM" != "vscode" ]]; then
    source /usr/share/blesh/ble.sh
  fi
fi
