#!/bin/bash
# shellcheck enable=require-variable-braces
# chezmoi:template:left-delimiter="#{{" right-delimiter=}}

[[ $- != *i* ]] && return

case ${TERM} in
  Eterm* | alacritty* | aterm* | foot* | gnome* | konsole* | kterm* | putty* | rxvt* | tmux* | xterm*)
    # shellcheck disable=SC2016
    PROMPT_COMMAND+=('printf "\e]0;%s@%s: %s\007" "${USER}" "${HOSTNAME%%.*}" "${PWD/#$HOME/\~}"');;
  screen*)
    # shellcheck disable=SC2016
    PROMPT_COMMAND+=('printf "\e_%s@%s: %s\e\\" "${USER}" "${HOSTNAME%%.*}" "${PWD/#$HOME/\~}"');;
esac

if [[ ${EUID} == 0 ]]; then
  PS1='${SUDO_USER:+(\[\e[01;33m$SUDO_USER\e[0m\]) }\[\e[01;31m\]\u@\h\[\e[00m\]: \[\e[01;34m\]\w\[\e[00m\] \n \[\e[01;31m\]\$_\[\e[00m\] '
else
  PS1='\[\e[01;32m\]\u@\h\[\e[00m\]: \[\e[01;34m\]\w\[\e[00m\] \n \[\e[01;32m\]\$_\[\e[00m\] '
fi

bind 'set completion-ignore-case on'
bind 'set match-hidden-files off'
bind -x '"\C-l":clear'
shopt -s autocd
shopt -s cdspell
shopt -s checkwinsize
shopt -s dirspell
shopt -s expand_aliases
shopt -s histappend
shopt -s no_empty_cmd_completion
shopt -s progcomp
shopt -s progcomp_alias
set -C

if [[ -r "${PREFIX:-/usr}/share/bash-completion/bash_completion" ]]; then
  # shellcheck disable=SC1091
  . "${PREFIX:-/usr}/share/bash-completion/bash_completion"
fi

#{{ if eq .deviceConfig.installType "termux" -}}
# shellcheck disable=SC1091,SC1094,SC2153
. "${PREFIX}/share/blesh/ble.sh"
#{{- else if ne .deviceConfig.osType "arch" -}}
# shellcheck disable=SC1091,SC1094
. "/usr/local/share/blesh/ble.sh"
#{{- else -}}
# shellcheck disable=SC1091,SC1094
. "/usr/share/blesh/ble.sh"
#{{- end }}

alias() {
  local arg alias_name alias_value

  builtin alias "$@"

  for arg in "$@"; do
    if [[ ${arg} =~ ^([^=]+)=[\'\"]?(.*)[\'\"]?$ ]]; then
      alias_name="${BASH_REMATCH[1]}"
      mapfile -t alias_value <<< "${BASH_REMATCH[2]}"
      [[ "${alias_name}" != "${alias_value[0]}" ]] && complete -r "${alias_name}" &>/dev/null
    fi
  done
}

if [[ -r ./.bash_tweaks ]]; then
  # shellcheck disable=SC1091
  . ./.bash_tweaks
fi

HISTCONTROL=ignoreboth
